# ════════════════════════════════════════════════════════════════════════
# Multi-Document Hybrid RAG — Environment Configuration
# Copy this file to .env and fill in your actual values.
# ════════════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0

# ── LLM Configuration ────────────────────────────────────────────────────
# Choose one provider: openai | google | groq
LLM_PROVIDER=groq
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# LLM Models (one per provider)
OPENAI_MODEL=gpt-4o-mini
GOOGLE_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# ── Embeddings & Reranking (local sentence-transformers) ─────────────────
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Database & Local Storage ─────────────────────────────────────────────
# Use postgresql+asyncpg:// for PostgreSQL (recommended for production)
# Use sqlite+aiosqlite:///./data/rag.db for local SQLite development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/multirag
FAISS_INDEX_DIR=./data/faiss_index
UPLOADS_DIR=./data/uploads

# ── AWS S3 Storage ────────────────────────────────────────────────────────
# Set S3_ENABLED=true to upload documents to S3 after local ingestion.
# Files are still processed locally; S3 is used for persistent cloud storage.
S3_ENABLED=false
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-rag-documents-bucket
S3_PREFIX=rag-documents

# ── Admin Panel Authentication ────────────────────────────────────────────
# This key protects upload and delete operations in the Admin Panel.
# CHANGE THIS to a strong random string before deploying!
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=change-me-admin-secret-key-2024

# ── Wix / CORS ────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
# Add your Wix site domain(s) here for the chatbot integration to work.
# Example: https://yoursite.wixsite.com,https://www.yoursite.com
# Use * to allow all origins (not recommended for production).
WIX_ALLOWED_ORIGINS=*

# ── RAG Hyperparameters ───────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5
